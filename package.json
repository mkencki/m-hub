{
  "name": "m-hub",
  "productName": "M-HUB",
  "version": "0.5.9",
  "description": "Messenger and two WhatsApp accounts in one window, each in an isolated session, with text macros and attachments",
  "author": "Marek Kencki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkencki/m-hub.git"
  },
  "homepage": "https://github.com/mkencki/m-hub",
  "main": "src/main/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-builder --win portable --publish never",
    "dist:installer": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "pl.kencki.msghub",
    "productName": "M-HUB",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "M-HUB",
      "artifactName": "M-HUB-${version}-installer.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "M-HUB-${version}-portable.exe"
    }
  }
}
